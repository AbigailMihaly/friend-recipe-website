
---
import Layout from '../../layouts/Layout.astro';
import { getRecipes } from '../../lib/recipes.js';

// Tells Astro to build one page per recipe
export async function getStaticPaths() {
  const recipes = await getRecipes();
  return recipes.map((r) => ({ params: { slug: r.slug }, props: { recipe: r } }));
}

const { recipe } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout title={recipe.title}>

	<main>
	<a href={`${base}/`}>← Back</a>
	<div class="recipe">
		<!-- Photo on the left -->
		{recipe.image && <img src={recipe.image} alt={recipe.title} />}

		<!-- All the text on the right -->
		<div class="info">
			<h2>{recipe.title}</h2>
			<p><strong>Recommended by:</strong> {recipe.recommender}</p>
			<p><strong>Recipe By:</strong> {recipe.source}</p>
			<p><strong>Tags:</strong> {recipe.tags.join(', ')}</p>
			<p><a href={recipe.link} target="_blank">See the full recipe ↗</a></p>
		</div>
	</div>
	</main>

	<!-- <main>
		<a href="/">← Back to all recipes</a>
		<h2>{recipe.title}</h2>
		{recipe.image && <img src={recipe.image} alt={recipe.title} />}
		<p><strong>Source:</strong> {recipe.source}</p>
		<p><strong>Recommended by:</strong> {recipe.recommender}</p>
		<p><strong>Tags:</strong> {recipe.tags.join(', ')}</p>
		<p><a href={recipe.link} target="_blank">View the full recipe ↗</a></p>
	</main> -->
</Layout>

<style>
	h2 { font-size: 2rem; color: var(--orange); }
	/* Side-by-side layout: photo left, text right */
	.recipe { display: flex; gap: 1.5rem; align-items: flex-start; margin-top: 1rem; }
	.info { flex: 1; }
	.info h2 { margin-top: 0; }

	/* Smaller square photo */
	img { width: 300px; aspect-ratio: 1 / 1; object-fit: cover; flex-shrink: 0; border: 0px solid var(--blue); border-radius: 16px; }

	/* On phones, stack the photo above the text */
	@media (max-width: 600px) { .recipe { flex-direction: column; } img { width: 100%; } }
</style>