
---
// Each page can pass its own title
const { title = 'BBL Recipe Library' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href={${base}/favicon.svg} />
		<meta name="generator" content={Astro.generator} />
		<link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@400;600;700&family=Caveat:wght@700&display=swap" rel="stylesheet" />		<title>{title}</title>
	</head>
	<body>
		<h1><a href={${base}/}>BBL Recipe Library</a></h1>
		<slot />
	</body>
</html>

<style is:global>
	/* Color palette: change these to restyle everything */
:root { --orange: #D95C45; --yellow: #F2D77A; --blue: #30392D; --cream: #F7F0E4; --green: #AFC49A; }

	body { margin: 0; font-family: 'Baloo 2', sans-serif; background: var(--cream); color: var(--blue); }
	h1 { font-family: 'Caveat', cursive; font-weight: 700; background: var(--green); margin: 0; padding: 1.5rem; text-align: center; font-size: 3.5rem; border-bottom: 6px solid var(--green); }
	h1 a { color: white; text-decoration: none; }
	main { max-width: 1000px; margin: 0 auto; padding: 1.5rem; }
	a { color: var(--blue); }
</style>



